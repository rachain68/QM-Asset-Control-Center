# Backend Deployment Environment Variables
# --------------------------------------
# Rename this file to `.env` on the production server.

# 1. API Port
PORT=5402

# 2. Database Connection (Update password as needed)
DB_HOST=10.50.20.20
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME_USERS=qm_users_db
DB_NAME_ASSETS=qm_assets_db

# 3. JWT Secret Key (Used for generating tokens)
JWT_SECRET=your_super_secret_jwt_key_here
